venv/
__pycache__/
*.pyc

# Buffers incrementales de la extraccion: se regeneran solos, no se versionan.
# El patron cubre tambien data/libros_ampliado_parcial.jsonl y cualquier corpus
# futuro. Los CSV resultantes SI se versionan.
data/*_parcial.jsonl

# Los HTML de tests/fixtures/ SI se versionan a proposito: son los que permiten
# correr los tests sin conexion y sin castigar al sitio. Ademas dejan registrado
# como era el HTML de Lectulandia al momento de la extraccion.

# Archivos de bloqueo que crean Excel / LibreOffice al abrir el CSV
.~lock.*#
~$*

# Configuracion local de conexion. Se versiona .env.example, no el .env real.
.env

# Modelos de embeddings entrenados: son artefactos regenerables con
# `python src/embeddings.py entrenar` y pesan varios MB.
data/modelos/
